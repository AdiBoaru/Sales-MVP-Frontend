# ── Supabase (read-only catalog) ─────────────────────────────────────────────
# The anon key reads NOTHING on its own: `anon` has no grants on the catalog since
# the demo-access migration. Reads ride on the session minted by the redeem-code
# edge function. See DEMO_ACCESS.md.
VITE_SUPABASE_URL=https://xfczucwqntefethxxien.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# ── izi chat bot ("Aria") ────────────────────────────────────────────────────
# Keep VITE_CHAT_API_BASE EMPTY in dev so requests go through the Vite /web proxy
# (which spoofs Origin to satisfy the bot's origin check). Prod injects the real value
# via the GitHub secret VITE_CHAT_API_BASE (= https://bot.nativextech.com) at build time.
VITE_CHAT_API_BASE=
VITE_CHAT_PUBLIC_TOKEN=pub_your_public_token

# Origin the dev proxy spoofs. Must match EXACTLY one of the bot's allowlisted origins:
# the bot checks `Origin` server-side on every /web/* route and compares after normalisation,
# so demo.x != www.demo.x != http://demo.x != demo.x:8443. Defaults to the storefront origin
# (https://demo.nativextech.com); override only if the bot's allowlist changes.
VITE_CHAT_DEV_ORIGIN=

# ── Protocolul de chat v2 (NX-243) ───────────────────────────────────────────
# "1" pornește calea v2 (turnuri durabile: POST /web/v2/turns + status/SSE + recovery).
# OFF implicit: v1 (/web/chat sincron) rămâne singura cale activă până la cutoverul NX-249.
# Cere ca botul să aibă WEB_TURN_V2_ENABLED=true (altfel rutele răspund 404) și, pentru SSE,
# WEB_TURN_SSE_ENABLED=true. Comutatorul e explicit: clientul NU detectează protocolul din payload.
#
# NX-244: se citește la BUILD, nu la runtime. `ChatWidget.jsx` îl compară literal, deci Vite îl
# înlocuiește înainte de bundling și Rollup elimină ramura moartă cu tot cu importurile ei —
# buildul v2 nu conține widgetul v1, `chatDemo.js` sau `?preview=1`. Consecință practică: nu poți
# schimba protocolul pe un build existent, ai nevoie de altul. Exact asta vrea NX-249 de la un
# canary — două artefacte distincte, promovabile și rollback-abile separat.
#
# Tot NX-244: cu v2 pornit, botul trebuie să servească `view_copy` la `GET /web/bootstrap` (copy-ul
# de shell). Fără el, widgetul rămâne fără nume până la primul răspuns — nu îl inventează.
VITE_CHAT_PROTOCOL_V2=

# ── Demo access gate — SERVER SIDE ONLY ──────────────────────────────────────
# Used by scripts/demo-codes.mjs (issuing) and by the redeem-code edge function
# (`supabase secrets set`). Generate each once with: openssl rand -hex 32
#   DEMO_CODE_PEPPER — peppers the code hash; rotating it invalidates every code
#   DEMO_AUTH_PEPPER — derives the synthetic users' passwords; rotating it locks
#                      out every existing code's user
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DEMO_CODE_PEPPER=
DEMO_AUTH_PEPPER=

# ⚠️ Never put service_role keys, peppers or DB passwords in VITE_* — anything
# prefixed VITE_ ends up verbatim in the browser bundle.
